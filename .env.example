# 공공데이터포털 (data.go.kr) API Key
# 건축물대장정보 서비스, 국토교통부 인허가 정보 등에 사용
DATA_GO_KR_API_KEY=

# VWorld API Key (브이월드) - 건물통합정보 / 배경 정사영상 타일 등에 사용
VWORLD_API_KEY=

# 국토지리정보원 국토정보플랫폼 계정 (자동 다운로드 API가 없는 경우 수동 다운로드 필요)
NGII_ACCOUNT_ID=
NGII_ACCOUNT_PW=

# ArcGIS Online 계정 (src/publish/arcgis_online.py - Hosted Feature/Tile Layer 발행용)
# Publisher 이상 권한 필요.
AGOL_USERNAME=
AGOL_PASSWORD=
AGOL_PORTAL_URL=https://www.arcgis.com
