__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
tmp/

# Data / outputs: never commit raw/derived geospatial data or large rasters.
# Directory structure is kept via .gitkeep; only actual data file types are ignored
# (blanket directory-level ignores break .gitkeep negation in nested folders).
data/raw/**/*.tif
data/raw/**/*.tiff
data/raw/**/*.jp2
data/raw/**/*.img
data/raw/**/*.gpkg
data/raw/**/*.shp
data/raw/**/*.shx
data/raw/**/*.dbf
data/raw/**/*.prj
data/raw/**/*.geojson
data/raw/**/*.xml
data/raw/**/*.zip
data/raw/**/*.json
data/interim/**/*
data/processed/**/*
!data/interim/.gitkeep
!data/processed/.gitkeep

# outputs_<T1>_<T2>/ 처럼 기간별로 분리된 실행 결과 디렉토리도 동일하게 적용.
outputs/rasters/**/*.tif
outputs/rasters/**/*.tiff
outputs/vectors/**/*.gpkg
outputs/vectors/**/*.geojson
outputs/vectors/**/*.shp
outputs/maps/**/*.png
outputs/maps/**/*.pdf
outputs/figures/**/*.png
outputs_*/rasters/**/*.tif
outputs_*/rasters/**/*.tiff
outputs_*/vectors/**/*.gpkg
outputs_*/vectors/**/*.geojson
outputs_*/vectors/**/*.shp
outputs_*/maps/**/*.png
outputs_*/maps/**/*.pdf
outputs_*/figures/**/*.png

# 프로젝트별 디렉토리(data/projects/<id>/..., outputs/<id>/...)도 동일 정책 적용.
# raw/processed/source_docs/arcgis 스크래치는 원본·파생 지리정보라 커밋하지 않는다.
data/projects/*/raw/
data/projects/*/processed/
data/projects/*/source_docs/
data/projects/*/aoi/
# 실제 벤더 계정에서 받은 단가/견적 등 상업적으로 민감할 수 있는 데이터
# (예: SkyWatch 단가 CSV) - PUBLIC 저장소에 커밋하지 않는다.
data/projects/*/metadata/
# 위 metadata에서 파생된 리포트도 동일한 실제 단가를 그대로 담고 있어 함께 제외.
outputs/kr_rail_nohari/reports/imagery_candidates.csv
outputs/kr_rail_nohari/reports/cost_scenarios.csv
outputs/kr_rail_nohari/reports/aerial_photography_rfq.md
outputs/kr_rail_nohari/reports/work_summary_*.html
outputs/arcgis/
outputs/*/arcgis/
outputs/*/comparisons/*/rasters/
outputs/*/comparisons/*/vectors/
outputs/*/comparisons/*/figures/
# kr_rail_nohari 등 comparisons/ 중첩 없이 outputs/<id>/{rasters,vectors,figures}/를
# 바로 쓰는 프로젝트 레이아웃 - 위와 동일한 정책(파생 지리정보/대용량 래스터 비커밋).
outputs/*/rasters/**/*.tif
outputs/*/rasters/**/*.tiff
outputs/*/vectors/**/*.gpkg
outputs/*/vectors/**/*.geojson
outputs/*/vectors/**/*.shp
outputs/*/figures/**/*.png

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
