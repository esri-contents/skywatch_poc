<?xml version="1.0" encoding="utf-8"?>
<ArcGIS defaultAssembly="GwangmyeongInterpretation.dll" defaultNamespace="GwangmyeongInterpretation"
        xmlns="http://schemas.esri.com/DADF/Registry" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://schemas.esri.com/DADF/Registry file:///C:/Program%20Files/ArcGIS/Pro/bin/ArcGIS.Desktop.Framework.xsd">
  <AddInInfo id="{6b1f4c2e-8d3a-4f57-9a1e-2c7d5e9b4a10}" version="1.2" desktopVersion="3.5.0">
    <Name>광명시흥 필지 구조물 판독</Name>
    <Description>항공사진 두 장(형식 무관)을 넣으면 광명시흥 공공주택지구 필지 단위 구조물 판독을 수행하고 공공기관 보고서 HTML과 결과 레이어를 만듭니다.</Description>
    <Author>skywatch_poc</Author>
    <Company>skywatch_poc</Company>
    <Date>2026-11-03</Date>
    <Subject>Framework</Subject>
  </AddInInfo>
  <modules>
    <insertModule id="GwangmyeongInterpretation_Module" className="Module1" autoLoad="false" caption="광명시흥 판독">
      <tabs>
        <tab id="GwangmyeongInterpretation_Tab" caption="광명시흥 판독" keytip="GM">
          <group refID="GwangmyeongInterpretation_Group" />
          <group refID="GwangmyeongInterpretation_FieldGroup" />
        </tab>
      </tabs>
      <groups>
        <group id="GwangmyeongInterpretation_Group" caption="필지 구조물 판독" appearsOnAddInTab="false" keytip="G">
          <button refID="GwangmyeongInterpretation_Run" size="large" />
          <button refID="GwangmyeongInterpretation_OpenReport" size="middle" />
          <button refID="GwangmyeongInterpretation_RebuildReport" size="middle" />
          <button refID="GwangmyeongInterpretation_AddLayers" size="middle" />
          <button refID="GwangmyeongInterpretation_OpenFolder" size="middle" />
          <button refID="GwangmyeongInterpretation_History" size="middle" />
        </group>
        <group id="GwangmyeongInterpretation_FieldGroup" caption="검수·현장조사" appearsOnAddInTab="false" keytip="S">
          <button refID="GwangmyeongInterpretation_Review" size="large" />
          <button refID="GwangmyeongInterpretation_SurveyExport" size="middle" />
          <button refID="GwangmyeongInterpretation_SurveyImport" size="middle" />
          <button refID="GwangmyeongInterpretation_ParcelSheets" size="middle" />
        </group>
      </groups>
      <controls>
        <button id="GwangmyeongInterpretation_Run" caption="판독 실행" className="RunButton" loadOnClick="true" keytip="R"
                smallImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/Imagery16.png"
                largeImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/Imagery32.png">
          <tooltip heading="항공사진 판독 실행">기준·비교 시기 항공사진(GeoTIFF·ECW·JP2·MrSID·JPG 등)을 넣으면 정합·판독·필지 집계 후 공공기관 보고서 HTML을 만듭니다. 30분 안팎 걸립니다.<disabledText /></tooltip>
        </button>
        <button id="GwangmyeongInterpretation_OpenReport" caption="보고서 열기" className="OpenReportButton" loadOnClick="true" keytip="O"
                smallImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/HtmlFile16.png"
                largeImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/HtmlFile32.png">
          <tooltip heading="보고서 열기">현재 결과의 보고서 HTML을 기본 브라우저로 엽니다(다시 만든 경우 가장 최근 것). 저장 위치: 출력 상위 폴더\실행 시각\interpretation\reports\<disabledText /></tooltip>
        </button>
        <button id="GwangmyeongInterpretation_RebuildReport" caption="보고서 다시 만들기" className="RebuildReportButton" loadOnClick="true" keytip="B"
                smallImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/GenericButtonOrange16.png"
                largeImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/GenericButtonOrange32.png">
          <tooltip heading="보고서 다시 만들기">검수표(qa/review1/qa_labels.csv)에 표본 검수 결과를 적은 뒤 실행하면 정밀도를 반영해 보고서만 다시 만듭니다. 이전 보고서는 덮어쓰지 않고, 새 보고서·붙임 1 SHP 이름 뒤에 생성 시각을 붙입니다.<disabledText /></tooltip>
        </button>
        <button id="GwangmyeongInterpretation_AddLayers" caption="결과 레이어 추가" className="AddLayersButton" loadOnClick="true" keytip="L"
                smallImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/AddLayerFromPath16.png"
                largeImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/AddLayerFromPath32.png">
          <tooltip heading="결과 레이어 추가">마지막 실행의 필지 상태·미등재·신규/소멸 레이어와 영상을 현재 지도에 추가합니다.<disabledText /></tooltip>
        </button>
        <button id="GwangmyeongInterpretation_OpenFolder" caption="결과 폴더" className="OpenFolderButton" loadOnClick="true" keytip="F"
                smallImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/FolderOpenState16.png"
                largeImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/FolderOpenState32.png">
          <tooltip heading="결과 폴더 열기">마지막 실행의 산출물 폴더(보고서·CSV·GPKG·근거 영상·검수표)를 탐색기로 엽니다.<disabledText /></tooltip>
        </button>
        <button id="GwangmyeongInterpretation_History" caption="실행 이력" className="HistoryButton" loadOnClick="true" keytip="H"
                smallImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/InspectionTable16.png"
                largeImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/InspectionTable32.png">
          <tooltip heading="실행 이력">지난 실행(날짜·입력 영상·소요 시간·주요 수치) 목록에서 보고서·레이어·폴더를 다시 열거나 현재 결과로 고릅니다.<disabledText /></tooltip>
        </button>
        <button id="GwangmyeongInterpretation_Review" caption="표본 검수" className="ReviewButton" loadOnClick="true" keytip="V"
                smallImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/InspectionViewer16.png"
                largeImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/InspectionViewer32.png">
          <tooltip heading="표본 검수">검수 표본 영상을 한 장씩 보며 구조물 맞음·아님·판단 불가를 판정합니다(단축키 1·2·3). 지도가 표본 위치로 따라갑니다.<disabledText /></tooltip>
        </button>
        <button id="GwangmyeongInterpretation_SurveyExport" caption="현장조사 내보내기" className="SurveyExportButton" loadOnClick="true" keytip="E"
                smallImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/ExcelWorkbookFile16.png"
                largeImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/ExcelWorkbookFile32.png">
          <tooltip heading="현장조사 내보내기">붙임 1·2 대상을 근거 영상이 붙은 엑셀 조사표와 Field Maps용 survey.gdb(도메인·사진 첨부 설정)로 내보냅니다.<disabledText /></tooltip>
        </button>
        <button id="GwangmyeongInterpretation_SurveyImport" caption="현장조사 결과 가져오기" className="SurveyImportButton" loadOnClick="true" keytip="I"
                smallImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/InspectionReport16.png"
                largeImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/InspectionReport32.png">
          <tooltip heading="현장조사 결과 가져오기">작성한 조사표(엑셀) 또는 Field Maps gdb를 읽어 보고서에 현장 정밀도·물건조서 누락 의심을 반영합니다.<disabledText /></tooltip>
        </button>
        <button id="GwangmyeongInterpretation_ParcelSheets" caption="필지 도면 PDF" className="ParcelSheetsButton" loadOnClick="true" keytip="P"
                smallImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/MapSeries16.png"
                largeImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/MapSeries32.png">
          <tooltip heading="필지 도면 PDF">붙임 1 필지마다 두 시기 영상·필지 정보가 들어간 A4 도면을 PDF 한 파일로 만듭니다(320쪽 약 3분). 저장 위치: 실행 폴더\필지도면_붙임1_생성시각.pdf<disabledText /></tooltip>
        </button>
      </controls>
      <dockPanes>
        <dockPane id="GwangmyeongInterpretation_ReviewPane" caption="표본 검수" className="ReviewPaneViewModel" dock="group" dockWith="esri_core_contentsDockPane">
          <content className="ReviewPaneView" />
        </dockPane>
      </dockPanes>
    </insertModule>
  </modules>
</ArcGIS>
