<Project Sdk="Microsoft.NET.Sdk">
  <!-- ArcGIS Pro 3.5 이상(3.5·3.6·3.7…) 공용 Add-in. Visual Studio 없이 `dotnet build -c Release`로 .esriAddinX를 만든다.
       Pro 3.5 SDK 참조 어셈블리(NuGet Esri.ArcGISPro.Extensions30 3.5, .NET 8)로 빌드하고 Config.daml의 desktopVersion을 3.5.0으로 둔다.
       Esri: Add-in은 3.x 안에서 상위 버전으로 호환(forward compatible)되고, 3.0~3.6용 Add-in은 3.7(.NET 10)에서 다시 빌드 없이 동작한다
       (ProConcepts-Advanced-Topics "Add-in Versioning", ProGuide-NET-10-Upgrade). 3.7 어셈블리로 빌드하면 3.5·3.6에서 로드되지 않는다.
       참조 어셈블리는 NuGet에서 받으므로 빌드 PC의 Pro 버전과 무관하다. .NET 8 참조 팩은 .NET 10 SDK가 자동으로 받는다.
       .esriAddinX 패키징만 빌드 PC에 설치된 Pro의 Esri.ProApp.SDK.Desktop.targets를 쓴다 - NuGet 3.5 패키지의 패키징 targets는
       CodeTaskFactory를 써서 `dotnet build`(.NET MSBuild)에서 실패하고 Visual Studio MSBuild에서만 된다(2026-11-06 실측). -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>GwangmyeongInterpretation</RootNamespace>
    <AssemblyName>GwangmyeongInterpretation</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>CA1416;CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Config.daml" />
    <Content Include="Config.daml" />
  </ItemGroup>
  <ItemGroup>
    <!-- 3.5 이상 공용: 이 버전을 올리면 그 버전 미만의 Pro에서 로드되지 않는다 -->
    <PackageReference Include="Esri.ArcGISPro.Extensions30" Version="3.5.0.57366" ExcludeAssets="build;buildTransitive" />
  </ItemGroup>
  <ItemGroup>
    <!-- 이 Add-in을 빌드한 저장소 폴더. 판독 코드 폴더 기본값으로 먼저 쓴다(같은 PC에 저장소 사본이 여럿이어도 빌드한 코드를 실행) -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildRepo</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <PropertyGroup>
    <ProInstallDir>$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\ESRI\ArcGISPro', 'InstallDir', null, RegistryView.Registry64))</ProInstallDir>
    <ProInstallDir Condition="'$(ProInstallDir)' == ''">C:\Program Files\ArcGIS\Pro\</ProInstallDir>
  </PropertyGroup>
  <Import Project="$(ProInstallDir)bin\Esri.ProApp.SDK.Desktop.targets" Condition="Exists('$(ProInstallDir)bin\Esri.ProApp.SDK.Desktop.targets')" />
  <Target Name="WarnNoProPackaging" AfterTargets="Build" Condition="!Exists('$(ProInstallDir)bin\Esri.ProApp.SDK.Desktop.targets')">
    <Warning Text="ArcGIS Pro가 설치되어 있지 않아 .esriAddinX를 만들지 않았습니다(DLL만 빌드됨). Pro 3.x가 설치된 PC에서 빌드하세요." />
  </Target>
</Project>
